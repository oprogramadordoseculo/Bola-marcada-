rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function dono(uid) { return logado() && request.auth.uid == uid; }
    function admin() {
      return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if dono(uid);
      allow write: if false;
    }

    match /usuarios/{uid} {
      allow get: if dono(uid) || admin();
      allow list: if admin();
      allow create: if dono(uid)
        && request.resource.data.premium == false
        && !('premiumAte' in request.resource.data);
      allow update: if admin()
        || (dono(uid) && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['geracoesHoje', 'dataHoje', 'email']));
      allow delete: if admin();
    }

    match /pedidos/{uid} {
      allow get: if dono(uid) || admin();
      allow list: if admin();
      allow create, update: if admin()
        || (dono(uid)
            && request.resource.data.status == 'pendente'
            && request.resource.data.uid == uid);
      allow delete: if admin();
    }

    match /combinacoes/{uid}/jogos/{jogo} {
      allow read, write: if dono(uid);
    }

    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
